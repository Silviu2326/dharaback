# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dharaterapeutas
DB_NAME=dharaterapeutas

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRE=30d

# Email Configuration (for notifications)
EMAIL_PROVIDER=sendgrid
# SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_api_key
# SMTP Configuration (alternativa)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@dharadimensionhumana.es
EMAIL_FROM_NAME=Dhara Dimensión Humana
EMAIL_SECURE=false

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# External Services
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase Configuration (for authentication and storage)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OAuth Configuration (managed through Supabase)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini AI (para análisis de titulaciones)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Configuration (for SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+34612345678

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Storage Configuration
STORAGE_TYPE=local
# For cloud storage (optional)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=eu-west-1

# Webhook URLs (for integrations)
WEBHOOK_SECRET=your_webhook_verification_secret

# Stripe Plan IDs
STRIPE_PLAN_BASICO_PRICE_ID=price_1TF520CWwvC7shbledurltKN
STRIPE_PLAN_AVANZADO_PRICE_ID=price_1TF4zwCWwvC7shblu5YwRnTt
STRIPE_PLAN_AVANZADO_PRO_PRICE_ID=price_1TEsH1CWwvC7shbl6iDqFFck

# Supabase
USE_SUPABASE=true

# Google Gemini AI
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_MODEL=gemini-2.0-flash

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key

# Migration Settings
MIGRATION_BATCH_SIZE=100
BACKUP_DIR=./backups