{
  "name": "dharaterapeutas-backend",
  "version": "1.0.0",
  "description": "Backend API for Dharaterapeutas platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testPathPatterns=src/tests --runInBand --forceExit --detectOpenHandles",
    "test:auth": "jest --testPathPatterns=src/tests/integration/auth --runInBand --forceExit",
    "test:users": "jest --testPathPatterns=src/tests/integration/users --runInBand --forceExit",
    "test:clients": "jest --testPathPatterns=src/tests/integration/clients --runInBand --forceExit",
    "test:bookings": "jest --testPathPatterns=src/tests/integration/bookings --runInBand --forceExit",
    "test:relations": "jest --testPathPatterns=src/tests/integration/relations --runInBand --forceExit",
    "test:verbose": "jest --testPathPatterns=src/tests --runInBand --forceExit --verbose",
    "seed": "node scripts/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "./src/tests/globalSetup.js",
    "globalTeardown": "./src/tests/globalTeardown.js"
  },
  "keywords": [
    "therapy",
    "api",
    "healthcare",
    "booking"
  ],
  "author": "Dharaterapeutas Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.0",
    "@supabase/supabase-js": "^2.96.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "mongoose-paginate-v2": "^1.9.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "sanitize-html": "^2.17.1",
    "stripe": "^14.14.0",
    "twilio": "^4.20.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
